# File cấu hình biến môi trường mẫu cho RAG Project
# Sao chép file này thành .env và điền các khóa API của bạn

# OpenAI API Key (Bắt buộc cho embedding, generation và Ragas evaluation)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (nếu dùng)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini (nếu dùng)
GOOGLE_API_KEY=your_google_api_key_here

# Cohere Rerank (nếu dùng Cohere reranker)
COHERE_API_KEY=your_cohere_api_key_here

# Vector Databases mở rộng (tuỳ chọn)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=
PINECONE_API_KEY=
DATABASE_URL=postgresql://user:password@localhost:5432/ragdb

# Local Storage
CHROMA_PERSIST_DIR=./storage
