    {
      "parameters": {
        "jsCode": "const body = $('SePay Webhook').item.json.body;\n\nconst content = body.content ?? '';\nconst amount = Number(body.transferAmount ?? 0);\nconst referenceCode = body.referenceCode ?? '';\n\nconst match = content.match(/DH(\\d+)/i);\n\nif (!match) {\n  throw new Error('Không tìm thấy mã đơn dạng DH<order_id>');\n}\n\nreturn [{\n  json: {\n    order_id: match[1],\n    amount,\n    referenceCode,\n    content\n  }\n}];"
      },
